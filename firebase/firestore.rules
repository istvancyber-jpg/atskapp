rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    match /groups/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /messages/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /read_receipts/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.user_id;
      allow delete: if false;
    }

    match /events/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /rsvps/{document} {
      allow create: if request.auth.uid == request.resource.data.user_id;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.user_id;
      allow delete: if false;
    }

    match /join_requests/{document} {
      allow create: if request.auth.uid == request.resource.data.user_id;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /access_changes/{document} {
      allow create: if request.auth.uid == request.resource.data.changed_by;
      allow read: if resource.data.target_user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    match /rsvp_changes/{document} {
      allow create: if request.auth.uid == request.resource.data.user_id;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }
  }
}
